# --- Percorsi ---
# /tmp e' montato come tmpfs (RAM): i file audio temporanei non toccano il disco
PATH_AUDIO=/tmp
SESSION_PATH=/app/session_data/baileys_auth

# --- Server di trascrizione (interno al container) ---
TRANSCRIBE_URL=http://127.0.0.1:8000/transcribe
TRANSCRIBE_TIMEOUT_MS=180000

# --- Filtri chat ---
# '*' = tutti i gruppi. Altrimenti elenco di ID separati da virgola.
GROUPS=*
# ID dei gruppi da escludere, separati da virgola
EXCLUDED_GROUPS=
# true per vedere gli ID reali nei log (serve per popolare EXCLUDED_GROUPS)
SHOW_CHAT_IDS=false

# --- Comportamento ---
# Trascrivi anche i vocali che invii tu
TRANSCRIBE_OWN_MESSAGES=true
# true = solo note vocali (ptt); false = anche file audio allegati
ONLY_PTT=false
# Ignora audio piu' lunghi di N secondi (0 = nessun limite)
MAX_AUDIO_SECONDS=0
# Segna come letti i messaggi trascritti
MARK_AS_READ=false

# --- Diagnostica ---
# silent | error | warn | info | debug | trace
BAILEYS_LOG_LEVEL=silent

TZ=Europe/Rome